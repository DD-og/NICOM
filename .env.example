# ---------------------------------------------------------------
# NICOM Review Portal configuration. Copy to .env.local (or Vercel →
# Settings → Environment Variables) and fill in.
# With nothing set, the app runs on local dummy data (data/seed.json).
# Sign-in: login ID + password (accounts live in the Faculty tab).
# ---------------------------------------------------------------

# Required in production: long random string used to sign login sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the portal (used for the Google sign-in redirect), e.g. https://nicom-review.vercel.app
APP_URL=

# --- Optional, later: Google sign-in in addition to ID + password ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only Google accounts on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=nirmauni.ac.in
# Comma-separated emails that are always admins (use this to let the first admin in).
MASTER_ADMIN_EMAILS=

# --- Data backend: "local" (demo JSON file), "appsscript" (Google Sheet via Apps Script, recommended
#     for deployment, no Google Cloud needed) or "sheets" (Google Sheet via a service account) ---
DATA_BACKEND=local

# --- Google Sheet via Apps Script (DATA_BACKEND=appsscript) — see README → Deploy ---
APPS_SCRIPT_URL=
# Must equal SECRET in apps-script/Code.gs
APPS_SCRIPT_SECRET=
# true = fill empty Faculty/Assignments/Reviews/Decisions tabs with the demo data once (testing only)
SEED_DEMO_DATA=

# --- Google Sheet via service account (DATA_BACKEND=sheets) ---
# Create a service account, enable the Sheets API, download its JSON key and
# share the Master Sheet with the service account email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key; keep the \n escapes, wrap in quotes.
GOOGLE_PRIVATE_KEY=
# Name of the tab that holds Google Form responses. Leave blank to use the first tab.
SUBMISSIONS_TAB=

# --- Review policy ---
REVIEWERS_PER_PAPER=2
# Double-blind: reviewers never see author names/emails. Keep true.
BLIND_REVIEW=true

# --- Decision emails (shown in the portal to copy and send) ---
CONFERENCE_NAME=NICOM 2026
# Optional: added as Cc and named as the contact address once the committee decides on one.
CONFERENCE_EMAIL=
JOURNAL_NAME=Nirma University Journal of Business and Management Studies
PAPER_ID_PREFIX=NICOM26-
