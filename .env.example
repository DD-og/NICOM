# ---------------------------------------------------------------
# NICOM Review Portal configuration. Copy to .env.local and fill in.
# With nothing set, the app runs in DEMO mode on data/seed.json.
# ---------------------------------------------------------------

# Required in production: long random string used to sign login sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# Data backend: "local" (demo JSON file) or "sheets" (Google Sheets).
DATA_BACKEND=local

# --- Google Sheets backend (DATA_BACKEND=sheets) ---
# Create a Google Cloud service account, enable the Sheets API, download its JSON key,
# and share the Master Sheet with the service account email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key; keep the \n escapes, wrap in quotes.
GOOGLE_PRIVATE_KEY=
# Name of the tab that holds Google Form responses. Leave blank to use the first tab.
SUBMISSIONS_TAB=

# --- Optional: create real Gmail drafts from the portal ---
# OAuth client (Desktop or Web) + a refresh token with scope https://www.googleapis.com/auth/gmail.compose
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Review policy ---
# true = faculty do not see author names/emails (double-blind). false = show them.
BLIND_REVIEW=true
# Conference details used in decision emails.
CONFERENCE_NAME=NICOM 2026
CONFERENCE_EMAIL=nicom@example.edu
JOURNAL_NAME=Nirma University Journal of Business and Management Studies
PAPER_ID_PREFIX=NICOM26-
