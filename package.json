{
  "name": "nicom-review-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/unit.test.ts",
    "test:e2e": "next build && playwright test && E2E_BACKEND=appsscript playwright test",
